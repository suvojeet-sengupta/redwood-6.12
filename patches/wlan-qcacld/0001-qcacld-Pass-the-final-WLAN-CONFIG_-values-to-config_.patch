From f285b30a82951d842cf1f81b45189281fab2f59c Mon Sep 17 00:00:00 2001
From: suvojeet-sengupta <suvojitsengupta21@gmail.com>
Date: Fri, 23 Oct 2026 12:01:09 +0000
Subject: [PATCH] qcacld: Pass the final WLAN CONFIG_ values to
 config_to_feature.h

Kleaf hands qcacld its CONFIG_ values as C defines; a plain Kbuild build
only has them as make variables, so config_to_feature.h saw none of them
and turned on things like CONFIG_BYPASS_QMI, which hangs the WPSS in
hif_post_static_buf_to_target. Write the final values to
configs/kbuild_defines.h for -include ahead of config_to_feature.h.

CONFIG_MULTI_IF_NAME is left out: as MULTI_IF_NAME it makes the driver
look for wlan/qca_cld/qca6750/WCNSS_qcom_cfg.ini, and redwood's vendor
only has wlan/qca_cld/WCNSS_qcom_cfg.ini, which 5.4 uses.
---
 Kbuild | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/Kbuild b/Kbuild
index 598c5f3..45cf4b6 100644
--- a/Kbuild
+++ b/Kbuild
@@ -4459,3 +4459,10 @@ OBJS_DIRS += $(dir $(OBJS)) \
 CLEAN_DIRS := $(addsuffix *.o,$(sort $(OBJS_DIRS))) \
 	      $(addsuffix .*.o.cmd,$(sort $(OBJS_DIRS)))
 clean-files := $(CLEAN_DIRS)
+
+# redwood: dump the final WLAN CONFIG_ values for config_to_feature.h, the way Kleaf
+# passes them; this plain Kbuild build only has them as make variables.
